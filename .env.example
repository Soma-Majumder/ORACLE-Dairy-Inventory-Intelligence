# Copy to .env for local dev. Set the same variables in your Vercel project's
# Environment Variables for production. .env is gitignored — never commit a key.

# Google Gemini API key for the "Ask ORACLE" agent (server-side only, never
# sent to the browser). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — extra origins allowed to call /api/ask, comma-separated
# (e.g. a custom domain). The deployment's own origin and localhost:4173
# are always allowed.
# ALLOWED_ORIGIN=https://your-domain.com

# Optional — Gemini models the endpoint may use, comma-separated. The first
# is the default. Update if Google renames its models.
# ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash

# Local dev server port (used by .claude/serve.mjs)
PORT=4173
